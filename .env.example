# ContractAR — ejemplo de configuración. NUNCA commitear valores reales.
# Red objetivo: Avalanche Fuji (43113). Sin fondos reales.

# ── Modo Fuji (contratos ya deployados por Nano) ─────────────────────────────
# shared/addresses.json es la autoridad de direcciones Fuji. Para correr contra
# Fuji copiá estos valores (verificados en Snowtrace):
# NEXT_PUBLIC_ESCROW_ADDRESS=0x48716Fe685f1c9Cb85Bc53B7e980685336b2261C
# NEXT_PUBLIC_TOKEN_ADDRESS=0x380Ef72aAd020e5C47e8117a6291D1397D174a86
# NEXT_PUBLIC_TREASURY_ADDRESS=0x6745CB1aE8673BA4966b324d6FF4aCCD8510C2A4
# NEXT_PUBLIC_CHAIN_ID=43113

# RPC público Fuji (se puede sobreescribir por uno con API key propia).
# CHAIN_RPC_URL tiene precedencia si ambas están seteadas (uso server-side).
NEXT_PUBLIC_FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc
# CHAIN_RPC_URL=
NEXT_PUBLIC_CHAIN_ID=43113

# Direcciones onchain — vacías en repo; dev-local.sh las inyecta desde
# shared/addresses.local.json (Anvil) o se copian de shared/addresses.json (Fuji).
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=

# Operador de demo (server-side, sólo testnet). Claves efímeras generadas por el
# servicio; jamás en frontend, URL, cerebro ni git. Sin esto la app corre en
# modo local/Anvil.
DEMO_OPERATOR_SECRET=dev-only
DEMO_KEYSTORE_PATH=./data/demo-keys.json

# Funder de demo: mint de tARGt (debe ser owner() del token) + AVAX para gas de
# cuentas efímeras. En local se usa la cuenta #0 de Anvil automáticamente.
# En Fuji está PENDIENTE: owner() del token es la cuenta de Nano; ver README.
# DEMO_FUNDER_KEY=

# Base de datos del ledger simulado (pesos)
LEDGER_DB_PATH=./data/ledger.db
